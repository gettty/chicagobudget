---
import Base from '../layouts/Base.astro';
import {displayName} from '../lib/displayName';
import {sourceUrl} from '../lib/sources';
import SideFacts from './SideFacts.astro';
import StaffingCount from './StaffingCount.astro';
import BudgetTreemap from './BudgetTreemap.astro';
import {budgetShare} from '../lib/budgetShare';
import { box,children,compact,exact,basisLabels,sourceFor,href,titles,manifest,type Box } from '../lib/data';
const {id,front=false}=Astro.props as {id:string;front?:boolean};
const node=box(id);
const displayed=node?.collapse_into?box(node.collapse_into)??node:node;
const entries=displayed?children(displayed.id):[];
const negative=entries.filter(n=>n.amount_cents<0&&n.kind!=='rounding');
const rounding=entries.filter(n=>n.kind==='rounding');
const path=displayed?.id.split('.')??[];
const crumbs=path.map((_,i)=>box(path.slice(0,i+1).join('.'))).filter((n):n is Box=>!!n);
const citations=displayed?sourceFor(displayed):[];
const root=displayed?.root??id.split('.')[0];
const period=displayed?.period_label??(displayed?.basis==='paid_to_date'?undefined:({city:'Calendar year 2026',cps:'FY2026 (July 2025–June 2026)',parks:'FY2026'} as Record<string,string>)[root]);
const subject=displayed?displayName(displayed):'Budget box';
const parent=crumbs.length>1?displayName(crumbs[crumbs.length-2]):undefined;
const pageTitle=displayed?`${subject}${parent?` in ${parent}`:''} Budget ${period?.includes('2026')?'2026':''}`.trim():'Box not found';
const description=displayed?`${subject}: ${exact(displayed.amount_cents)} in the ${titles[root]??'Chicago public'} budget${period?` (${period})`:''}. Explore its breakdown and public sources.`:'This budget box could not be found.';
const breadcrumbs=displayed?[{name:'Home',url:'/'},...crumbs.map(n=>({name:displayName(n),url:href(n)}))]:[];
---
<Base title={pageTitle} description={description} breadcrumbs={breadcrumbs} noindex={!displayed}><div class="stack hero box-page">{displayed ? <><nav class="breadcrumbs" aria-label="Breadcrumb"><ol>{crumbs.map(n=><li><a href={href(n)} title={n.name}>{displayName(n)}</a></li>)}</ol></nav><header class="box-hero"><div class="box-hero-main"><p class="eyebrow">{titles[displayed.root??id.split('.')[0]]??'Budget box'}</p><h1 tabindex="-1" title={displayed.name}>{displayName(displayed)}</h1>{displayName(displayed)!==displayed.name&&<details><summary>Official budget title</summary><p>{displayed.name}</p></details>}<div class="amount">{compact(displayed.amount_cents)}</div><p>Exact amount: <strong>{exact(displayed.amount_cents)}</strong></p>{period&&<p class="budget-period">{period}</p>}<StaffingCount id={displayed.id} />{displayed.basis&&!['budget','tied'].includes(displayed.basis)&&<span class="badge" data-basis={displayed.basis}>{basisLabels[displayed.basis]??displayed.basis}</span>}{displayed.note&&<p>{displayed.note}</p>}{displayed.why&&<p class="callout">{displayed.why}</p>}{displayed.amount_cents<0&&<p>This box takes money away from the box above.</p>}<p><a class="flow-link" href={`/?box=${encodeURIComponent(displayed.id)}`}>Explore this flow <span aria-hidden="true">↗</span></a> <a class="search-link" href={`/find?budget=${encodeURIComponent(displayed.root??id.split('.')[0])}`}>Search this budget →</a></p></div></header>{front&&<div class="callout"><p>Positive amounts fill the proportional map below; reductions and small amounts remain in the complete list. Estimates and leftovers have their own labels. <a href="/glossary">What do the labels mean?</a></p>{manifest.coverage?.[id]&&<p><strong>{Math.round(manifest.coverage[id].strict.lt1m*100)} cents of every dollar</strong> reach a box under $1 million by the box you land on. If each budgeted position counts as its own small box, it is {Math.round(manifest.coverage[id].build.lt1m*100)} cents. <a href="/gaps">See what we could not find</a>.</p>}</div>}{id==='city'&&<p><a href="/city/counted-twice">See money counted twice between City funds</a>. It is not part of the City net total.</p>}{id==='cps'&&<p>CPS fiscal year 2026 runs from July 2025 through June 2026.</p>}{entries.length>0 ? <section class="inside-section" id="inside" aria-labelledby="inside-heading"><div class="inside-intro"><p class="eyebrow">Follow the money</p><h2 id="inside-heading">Inside this box</h2><p>Pick a rectangle to see what is inside it. Rectangle area shows positive amounts; the complete list includes reductions and tiny amounts.</p></div>{negative.length>0&&<p>Boxes that add money total {exact(entries.filter(n=>n.amount_cents>0).reduce((sum,n)=>sum+n.amount_cents,0))}. Boxes that take money away total {exact(entries.filter(n=>n.amount_cents<0).reduce((sum,n)=>sum+n.amount_cents,0))}. Together they make {exact(displayed.amount_cents)}.</p>}<BudgetTreemap parent={displayed} entries={entries} nested={front&&['city','cps','parks'].includes(id)} />{negative.length>0&&<section aria-labelledby="negative-heading"><h3 id="negative-heading">Boxes that take money away</h3><ul>{negative.map(n=><li><a href={href(n)} title={n.name}>{displayName(n)}</a>: {exact(n.amount_cents)}</li>)}</ul></section>}<h3 id="all-boxes">All items</h3><div class="table-scroll"><table><caption title={displayed.name}>Percentages of {displayName(displayed)}</caption><thead><tr><th scope="col">Box</th><th scope="col">Amount</th><th scope="col">% of this budget</th></tr></thead><tbody>{entries.filter(n=>n.kind!=='rounding').map(n=><tr><th scope="row"><a href={href(n)} title={n.name}>{displayName(n)}</a>{n.basis&&!['budget','tied'].includes(n.basis)&&<small class="basis-note"> · {basisLabels[n.basis]??n.basis}</small>}</th><td class="numeric">{exact(n.amount_cents)}</td><td class="numeric">{budgetShare(n.amount_cents,displayed.amount_cents)??'N/A'}</td></tr>)}</tbody></table></div>{rounding.length>0&&<p>Plus rounding: {exact(rounding.reduce((sum,n)=>sum+n.amount_cents,0))}.</p>}</section>:<p>This box has no smaller boxes to open.</p>}{citations.length>0&&<section class="sources-section"><h2>Sources</h2><ul>{citations.map(s=><li>{sourceUrl(s)?<a href={sourceUrl(s)} rel="noopener noreferrer">{s.name??s.doc??'View source'}</a>:<span>{s.name??s.doc??'Public source'}</span>}</li>)}</ul></section>}<SideFacts side={displayed.side} sideRef={displayed.side_ref} />{displayed.parent_id&&<p><a href={href(box(displayed.parent_id)??{id:displayed.parent_id,name:'Parent',amount_cents:0})}>↑ Up one level</a></p>}</> : <><h1>Box not found</h1><p>This link may have changed after a data update.</p><a href="/find">Search for the box</a></>}</div></Base>
<style>
.box-page{padding-top:1rem;gap:1.25rem}.box-page .breadcrumbs{margin-bottom:0}.box-page .breadcrumbs ol{gap:.3rem .6rem;font-size:.85rem}.box-page .breadcrumbs a{color:var(--link)}
.box-hero{background:var(--paper);color:var(--ink);border:1px solid var(--line);border-top:3px solid var(--accent);border-radius:var(--radius);padding:clamp(1.2rem,3vw,2rem)}.box-hero-main{min-width:0}.box-hero .eyebrow{color:var(--muted);margin:0}.box-hero h1{font-size:clamp(2rem,4vw,3.4rem);line-height:1.12;letter-spacing:-.035em;margin:.3rem 0 .7rem;overflow-wrap:anywhere}.box-hero .amount{font-size:clamp(1.8rem,3vw,2.7rem);font-weight:750;color:var(--ink);line-height:1.1}.box-hero p{max-width:75ch;margin:.65rem 0}.box-hero .badge{margin:.2rem 0}.box-hero .callout{color:var(--ink)}.flow-link{display:inline-flex;align-items:center;gap:.7rem;min-height:2.7rem;background:var(--accent);color:var(--accent-ink, var(--paper));padding:.5rem 1rem;border-radius:var(--radius-sm);font-weight:750;text-decoration:none}.flow-link:hover{background:var(--ink);color:var(--paper)}.search-link{display:inline-block;margin:.5rem 0 .5rem .8rem;color:var(--link);font-weight:700}
.box-page>.callout{border-left:3px solid var(--accent);background:var(--surface-subtle);padding:.85rem 1.1rem}.box-page>.callout p{margin:.4rem 0}.inside-section{scroll-margin-top:2rem}.inside-intro{margin:.5rem 0 1rem}.inside-intro .eyebrow{margin:0;color:var(--muted)}.inside-intro h2{font-size:clamp(1.5rem,2.5vw,2.1rem);letter-spacing:-.025em;margin:.2rem 0}.inside-intro p:last-child{color:var(--muted);margin:.25rem 0}.box-page .table-scroll{border:1px solid var(--line);border-radius:var(--radius-sm)}.box-page table{min-width:600px}.box-page table caption{text-align:left;padding:.6rem 1rem;font-weight:700}.box-page th{background:var(--surface-subtle)}.box-page tr:hover td,.box-page tr:hover th{background:var(--surface-subtle)}.sources-section{border-top:1px solid var(--line);padding-top:1rem}.sources-section ul{line-height:1.7}
</style>
