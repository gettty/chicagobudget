---
import '../styles/global.css';
import {canonicalUrl, isInternalRoute, SITE_ORIGIN} from '../lib/seo';
const {title='Chicago budget explorer', description='Explore public budgets for the City of Chicago, Chicago Public Schools, and the Chicago Park District.', noindex=false, breadcrumbs=[]}=Astro.props as {title?:string;description?:string;noindex?:boolean;breadcrumbs?:{name:string;url:string}[]};
const current=Astro.url.pathname;
const canonical=canonicalUrl(current);
const pageTitle=title.includes('Chicago Budget') || title.includes('Chicago budget explorer') ? title : `${title} | Chicago Budget`;
const robotsNoindex=noindex || isInternalRoute(current);
const structuredData=robotsNoindex ? [] : [
  ...(current==='/' ? [{ '@context':'https://schema.org', '@type':'WebSite', name:'Chicago Budget', url:SITE_ORIGIN+'/', description }] : []),
  ...(breadcrumbs.length>1 ? [{ '@context':'https://schema.org', '@type':'BreadcrumbList', itemListElement: breadcrumbs.map((item, i)=>({'@type':'ListItem',position:i+1,name:item.name,item:canonicalUrl(item.url)})) }] : []),
];
const analyticsToken=import.meta.env.PUBLIC_CF_ANALYTICS_TOKEN;
const secondaryNav=[['/city','City'],['/cps','Schools'],['/parks','Parks'],['/guides','Guides'],['/datasets','Datasets'],['/about','About']];
const active=(url:string)=>current===url || (url!=='/find' && url!=='/about' && current.startsWith(`${url}/`));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width,initial-scale=1"/>
    <meta name="description" content={description}/>
    {robotsNoindex&&<meta name="robots" content="noindex,follow"/>}
    {!robotsNoindex&&<link rel="canonical" href={canonical}/>}
    <meta property="og:type" content="website"/>
    <meta property="og:title" content={pageTitle}/>
    <meta property="og:description" content={description}/>
    <meta property="og:url" content={canonical}/>
    <meta name="twitter:card" content="summary"/>
    {structuredData.map(data=><script type="application/ld+json" set:html={JSON.stringify(data).replace(/</g,'\\u003c')}/>)}
    <meta name="theme-color" content="#f4f2ec"/>
    <title>{pageTitle}</title>
    {analyticsToken&&<script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({token:analyticsToken})}></script>}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/" aria-label="Chicago Budget home"><svg class="brand-mark" viewBox="0 0 32 32" width="30" height="30" aria-hidden="true"><path d="M16 0 20 9 29.9 8 24 16 29.9 24 20 23 16 32 12 23 2.1 24 8 16 2.1 8 12 9Z" fill="currentColor"/></svg><span>Chicago<span class="brand-second">Budget</span></span></a>
        <span class="brand-caption">Public money.<br/>A clearer picture.</span>
        <nav aria-label="Main navigation" class="nav desktop-nav">
          <a class="nav-primary" href="/#explore" aria-current={current==='/'?'page':undefined}>Explore</a>
          <a class="nav-primary nav-find" href="/find" aria-current={active('/find')?'page':undefined}>Find</a>
          <span class="nav-divider" aria-hidden="true"></span>
          {secondaryNav.map(([url,label])=><a href={url} aria-current={active(url)?'page':undefined}>{label}</a>)}
        </nav>
        <nav aria-label="Explore and find" class="nav mobile-primary">
          <a class="nav-primary" href="/#explore" aria-current={current==='/'?'page':undefined}>Explore</a>
          <a class="nav-primary nav-find" href="/find" aria-current={active('/find')?'page':undefined}>Find</a>
        </nav>
        <details class="mobile-nav">
          <summary>More</summary>
          <nav aria-label="More navigation" class="nav">{secondaryNav.map(([url,label])=><a href={url} aria-current={active(url)?'page':undefined}>{label}</a>)}</nav>
        </details>
      </div>
    </header>
    <main id="main" class="wrap" tabindex="-1"><slot/></main>
    <footer class="site-footer">
      <div class="wrap">
        <div class="footer-heading"><span>Chicago Budget<span class="footer-star" aria-hidden="true">✶</span></span><p>An independent look at our public money.</p></div>
        <nav aria-label="Footer navigation"><a href="/guides/">Guides</a><a href="/datasets/">Datasets</a><a href="/methods">Methods</a><a href="/disclosures">Disclosures</a><a href="/sources">Sources</a><a href="/glossary">Glossary</a><a href="/gaps">What we could not find</a><a href="/contribute">Contribute</a></nav>
      </div>
    </footer>
  </body>
</html>
